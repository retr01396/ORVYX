# ==============================================================================
# ORVYX Medical-Imaging Workstation — Environment Configuration
# ==============================================================================

# Co-Pilot AI Provider selection:
#   deterministic (default) — 100% offline, deterministic clinical engine. No network calls.
#   custom_llm             — Connects to a self-hosted OpenAI-compatible endpoint (e.g. Ollama, vLLM).
#   api                    — Connects to an external OpenAI-compatible API (e.g. OpenAI, Anthropic gateway).
COPILOT_PROVIDER=deterministic

# ------------------------------------------------------------------------------
# Custom LLM Configuration (used when COPILOT_PROVIDER=custom_llm)
# ------------------------------------------------------------------------------
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=llama3.2

# ------------------------------------------------------------------------------
# External AI API Configuration (used when COPILOT_PROVIDER=api)
# NOTE: Never commit actual API keys to version control.
# ------------------------------------------------------------------------------
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_API_MODEL=gpt-4o-mini
