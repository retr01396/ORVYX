# ==============================================================================
# ORVYX Medical-Imaging Workstation — Environment Configuration Template
# ==============================================================================

# Co-Pilot AI Provider selection:
#   deterministic (default) — 100% offline, deterministic clinical engine. No network calls.
#   claude                 — Anthropic Claude API provider (requires ANTHROPIC_API_KEY)
#   deepseek               — DeepSeek API provider (requires DEEPSEEK_API_KEY)
#   custom_llm             — Self-hosted OpenAI-compatible endpoint (e.g. Ollama, vLLM, FreeLLMAPI)
COPILOT_PROVIDER=deterministic

# ------------------------------------------------------------------------------
# Anthropic Claude Configuration (used when COPILOT_PROVIDER=claude)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ------------------------------------------------------------------------------
# DeepSeek Configuration (used when COPILOT_PROVIDER=deepseek)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# Custom LLM / Local Gateway (used when COPILOT_PROVIDER=custom_llm)
# Also supports standard BASE_URL and API_KEY aliases.
# ------------------------------------------------------------------------------
CUSTOM_LLM_BASE_URL=http://127.0.0.1:31415/v1
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=default
